<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GameHook.UI.Views.AboutWindow"
        Title="About GameHook"
        Width="500" SizeToContent="Height"
        MinWidth="500" MinHeight="375" MaxWidth="500"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#151617"
        FontFamily="Consolas,DejaVu Sans Mono,monospace">

    <Window.Resources>
        <SolidColorBrush x:Key="BorderBrush" Color="#3B3E43" />
        <SolidColorBrush x:Key="TextBrush" Color="#E3E6EB" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#9299A4" />
        <SolidColorBrush x:Key="AccentBrush" Color="#3D82CF" />
    </Window.Resources>

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        </Style>
    </Window.Styles>

    <StackPanel Margin="24,20" Spacing="12">
        <TextBlock Text="GameHook is a debugging tool for reading and modifying emulator memory."
                   Classes="muted" FontSize="12" LineHeight="19" TextWrapping="Wrap" />
        <Border Background="#191A1C" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12,9" Margin="0,2,0,0">
            <StackPanel Spacing="3">
                <TextBlock Text="VERSION" FontSize="9" FontWeight="SemiBold" Foreground="#7F9DC0" LetterSpacing="1" />
                <TextBlock Name="AppVersionText" FontSize="12" />
            </StackPanel>
        </Border>
        <Border Name="MapperVersionCard" Background="#191A1C" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" Padding="12,9" Margin="0,2,0,0" IsVisible="False">
            <StackPanel Spacing="3">
                <TextBlock Text="MAPPER VERSION" FontSize="9" FontWeight="SemiBold" Foreground="#7F9DC0" LetterSpacing="1" />
                <TextBlock Name="MapperVersionText" FontSize="12" />
            </StackPanel>
        </Border>
        <Border Background="#191A1C" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12,9">
            <StackPanel Spacing="3">
                <TextBlock Text="WEBSITE" FontSize="9" FontWeight="SemiBold" Foreground="#7F9DC0" LetterSpacing="1" />
                <TextBlock Text="https://gamehook.io/" FontSize="12" Foreground="{StaticResource AccentBrush}"
                           Cursor="Hand" PointerPressed="Website_PointerPressed" />
            </StackPanel>
        </Border>
        <Border Background="#191A1C" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12,9">
            <StackPanel Spacing="3">
                <TextBlock Text="DISCORD" FontSize="9" FontWeight="SemiBold" Foreground="#7F9DC0" LetterSpacing="1" />
                <TextBlock Text="https://discord.gg/rQbdcZF2AP" FontSize="12" Foreground="{StaticResource AccentBrush}"
                           Cursor="Hand" PointerPressed="Discord_PointerPressed" />
            </StackPanel>
        </Border>
        <StackPanel Name="AppUpdatePanel" IsVisible="False" Spacing="8">
            <TextBlock Name="AppUpdateText" TextWrapping="Wrap" Classes="muted" FontSize="12" />
            <Button Name="RestartUpdateButton" Content="Restart to update" IsVisible="False"
                    Click="RestartUpdateButton_Click" />
        </StackPanel>
    </StackPanel>
</Window>
