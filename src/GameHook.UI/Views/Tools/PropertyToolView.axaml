<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GameHook.UI.ViewModels"
             xmlns:tools="using:GameHook.UI.ViewModels.Tools"
             xmlns:domain="using:GameHook.Domain.Interface"
             x:Class="GameHook.UI.Views.Tools.PropertyToolView"
             x:Name="Root"
             x:DataType="tools:PropertyToolViewModel">
    <UserControl.Styles>
        <Style Selector="TextBlock.inspector-label">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#7F9DC0" />
            <Setter Property="LetterSpacing" Value="0.7" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.inspector-value">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="Border.inspector-row">
            <Setter Property="Padding" Value="0,7" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style Selector="Border.editor-card">
            <Setter Property="Padding" Value="12" />
            <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>
        <Style Selector="Button.value-editor-action">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.value-editor-action:disabled">
            <Setter Property="Opacity" Value="0.45" />
        </Style>
    </UserControl.Styles>

    <Grid Background="{StaticResource SurfaceBrush}">
        <StackPanel Spacing="8" Margin="22" HorizontalAlignment="Center" VerticalAlignment="Center"
                    IsVisible="{Binding IsEmpty}">
            <Border Width="46" Height="46" Background="{StaticResource SurfaceMutedBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <TextBlock Text="i" Foreground="#6E9ED4"
                           FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="No property selected" FontSize="14" FontWeight="SemiBold" TextAlignment="Center" />
            <TextBlock Text="Select a property in the tree, hex viewer, or Pinned list to inspect it."
                       Classes="muted" TextAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Raw byte selection and mapped-property selection are mutually exclusive. -->
        <ScrollViewer IsVisible="{Binding HasSelection}" AllowAutoHide="False">
            <StackPanel Margin="16,14" Spacing="12">
                <StackPanel Spacing="4">
                    <TextBlock FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap">
                        <Run Text="Address range " />
                        <Run Text="{Binding SelectionAddressRange}" />
                    </TextBlock>
                    <Border Classes="inspector-row">
                        <Grid ColumnDefinitions="112,*">
                            <TextBlock Grid.Column="0" Text="RAW BYTES" Classes="inspector-label" />
                            <TextBlock Grid.Column="1" Text="{Binding SelectionRawBytesHex, TargetNullValue='—'}" Classes="inspector-value" />
                        </Grid>
                    </Border>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding SelectionParses}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SelectionParseViewModel">
                            <Border Classes="inspector-row">
                                <StackPanel Spacing="3">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="1" Text="{Binding Type}" Classes="eyebrow" Margin="10,0,0,0" />
                                    </Grid>
                                    <TextBlock Text="{Binding DisplayValue}" Foreground="#82B8F2"
                                               Classes="inspector-value" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer IsVisible="{Binding HasSelectedProperty}" AllowAutoHide="False">
            <StackPanel Margin="16,14" Spacing="14" DataContext="{Binding ActiveNode}"
                        x:DataType="vm:PropertyTreeNodeViewModel">
                <StackPanel Spacing="4">
                    <TextBlock Text="{Binding Property.Name}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                </StackPanel>

                <Border Classes="editor-card">
                    <StackPanel Spacing="4" DataContext="{Binding #Root.DataContext}" x:DataType="tools:PropertyToolViewModel">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="EDIT VALUE" Classes="eyebrow" />
                            <TextBlock Grid.Column="1" Text="Decoded value" Classes="muted" FontSize="11" />
                        </Grid>
                        <Grid ColumnDefinitions="*,80,80" ColumnSpacing="6">
                            <ComboBox Grid.Column="0" ItemsSource="{Binding ReferenceValues}" SelectedItem="{Binding EditValueText, Mode=TwoWay}"
                                      FontSize="18" FontWeight="SemiBold" Foreground="#82B8F2"
                                      IsVisible="{Binding CanEditReference}" />
                            <ToggleSwitch Grid.Column="0" IsChecked="{Binding EditBooleanValue, Mode=TwoWay}"
                                          Content="Enabled" IsVisible="{Binding CanEditBoolean}" />
                            <NumericUpDown Grid.Column="0" Value="{Binding EditNumberValue, Mode=TwoWay}"
                                           FormatString="0" Increment="1" ClipValueToMinMax="False"
                                           FontSize="18" FontWeight="SemiBold" Foreground="#82B8F2"
                                           IsVisible="{Binding CanEditNumber}" />
                            <TextBox Grid.Column="0" Text="{Binding EditValueText, Mode=TwoWay}" FontSize="18" FontWeight="SemiBold"
                                     Foreground="#82B8F2" IsVisible="{Binding CanEditString}" />
                            <ItemsControl Grid.Column="0" ItemsSource="{Binding BitValues}" IsVisible="{Binding CanEditBitArray}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ToggleSwitch Margin="0,0,12,4" Content="{Binding Label}"
                                                      IsChecked="{Binding IsSet, Mode=TwoWay}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Grid.Column="0" Text="{Binding ActiveNode.DisplayValue, TargetNullValue='—'}" FontSize="18" FontWeight="SemiBold"
                                       Foreground="#82B8F2" TextWrapping="Wrap" IsVisible="{Binding ShowReadOnlyValue}" />
                            <Button Grid.Column="1" Classes="action value-editor-action" Content="Save" Click="SaveValueButton_Click"
                                    HorizontalAlignment="Stretch" MinWidth="0" IsEnabled="{Binding HasPendingValueEdit}"
                                    IsVisible="{Binding HasEditableValue}" />
                            <Button Grid.Column="2" Content="Cancel" Classes="secondary value-editor-action" Click="CancelValueButton_Click"
                                    HorizontalAlignment="Stretch" MinWidth="0" IsEnabled="{Binding HasPendingValueEdit}"
                                    IsVisible="{Binding HasEditableValue}" />
                        </Grid>
                        <TextBlock Text="{Binding EditError}" Foreground="#E06C6C" FontSize="12" TextWrapping="Wrap"
                                   IsVisible="{Binding HasEditError}" />
                    </StackPanel>
                </Border>

                <StackPanel Spacing="2">
                    <TextBlock Text="READING" Classes="eyebrow" Margin="0,0,0,2" />
                    <Border Classes="inspector-row">
                        <Grid ColumnDefinitions="112,*">
                            <TextBlock Grid.Column="0" Text="RAW BYTES" Classes="inspector-label" />
                            <TextBlock Grid.Column="1" Text="{Binding RawBytesHex, TargetNullValue='—'}" Classes="inspector-value" />
                        </Grid>
                    </Border>
                    <Border Classes="inspector-row" DataContext="{Binding Property}" x:DataType="domain:IProperty">
                        <Grid ColumnDefinitions="112,*">
                            <TextBlock Grid.Column="0" Text="TYPE" Classes="inspector-label" />
                            <TextBlock Grid.Column="1" Text="{Binding Type}" Classes="inspector-value" />
                        </Grid>
                    </Border>
                    <Border Classes="inspector-row" DataContext="{Binding Property}" x:DataType="domain:IProperty">
                        <Grid ColumnDefinitions="112,*">
                            <TextBlock Grid.Column="0" Text="LENGTH" Classes="inspector-label" />
                            <TextBlock Grid.Column="1" Text="{Binding Length, StringFormat='{}{0} bytes'}" Classes="inspector-value" />
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="2" DataContext="{Binding Property}" x:DataType="domain:IProperty">
                    <TextBlock Text="SOURCE" Classes="eyebrow" Margin="0,0,0,2" />
                    <Border Classes="inspector-row">
                        <Grid ColumnDefinitions="112,*">
                            <TextBlock Grid.Column="0" Text="ADDRESS" Classes="inspector-label" />
                            <TextBlock Grid.Column="1" Text="{Binding Address, StringFormat='0x{0:X}', TargetNullValue='—'}" Classes="inspector-value" />
                        </Grid>
                    </Border>
                    <Border Classes="inspector-row">
                        <Grid ColumnDefinitions="112,*">
                            <TextBlock Grid.Column="0" Text="REGION" Classes="inspector-label" />
                            <TextBlock Grid.Column="1" Text="{Binding Region, TargetNullValue='—'}" Classes="inspector-value" />
                        </Grid>
                    </Border>
                    <Border Classes="inspector-row">
                        <Grid ColumnDefinitions="112,*">
                            <TextBlock Grid.Column="0" Text="CONTAINER" Classes="inspector-label" />
                            <TextBlock Grid.Column="1" Text="{Binding MemoryContainer, TargetNullValue='—'}" Classes="inspector-value" />
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="2" DataContext="{Binding Property}" x:DataType="domain:IProperty">
                    <TextBlock Text="DECODING" Classes="eyebrow" Margin="0,0,0,2" />
                    <Border Classes="inspector-row">
                        <Grid ColumnDefinitions="112,*">
                            <TextBlock Grid.Column="0" Text="BITS" Classes="inspector-label" />
                            <TextBlock Grid.Column="1" Text="{Binding Bits, TargetNullValue='—'}" Classes="inspector-value" />
                        </Grid>
                    </Border>
                    <Border Classes="inspector-row">
                        <Grid ColumnDefinitions="112,*">
                            <TextBlock Grid.Column="0" Text="REFERENCE" Classes="inspector-label" />
                            <TextBlock Grid.Column="1" Text="{Binding Reference, TargetNullValue='—'}" Classes="inspector-value" />
                        </Grid>
                    </Border>
                    <Border Classes="inspector-row">
                        <Grid ColumnDefinitions="112,*">
                            <TextBlock Grid.Column="0" Text="CHARACTER MAP" Classes="inspector-label" />
                            <TextBlock Grid.Column="1" Text="{Binding CharacterMap, TargetNullValue='—'}" Classes="inspector-value" />
                        </Grid>
                    </Border>
                    <Border Classes="inspector-row">
                        <Grid ColumnDefinitions="112,*">
                            <TextBlock Grid.Column="0" Text="STATIC VALUE" Classes="inspector-label" />
                            <TextBlock Grid.Column="1" Text="{Binding StaticValue, TargetNullValue='—'}" Classes="inspector-value" />
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
