<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GameHook.UI.Controls.FieldCard"
             x:Name="Root">
    <!--
        Shared by every "eyebrow label + value" card in the Inspector panel (ADDRESS, TYPE,
        LENGTH, CURRENT VALUE, ...) so they all get the same padding and typography instead
        of each call site hand-rolling its own Border/StackPanel/TextBlock trio.
    -->
    <UserControl.Styles>
        <Style Selector="Border.field-card">
            <Setter Property="Padding" Value="14,13" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.field-card.accent">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentDarkBrush}" />
        </Style>
        <Style Selector="TextBlock.field-value">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="Border.field-card.accent TextBlock.field-value">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#82B8F2" />
        </Style>
    </UserControl.Styles>

    <Border Classes="field-card" Classes.accent="{Binding Accent, ElementName=Root}">
        <StackPanel Spacing="7">
            <TextBlock Classes="eyebrow" Text="{Binding Label, ElementName=Root}" />
            <TextBlock Classes="field-value" Text="{Binding ValueText, ElementName=Root}" />
        </StackPanel>
    </Border>
</UserControl>
