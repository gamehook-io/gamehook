<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Gamehook.Android.App"
             RequestedThemeVariant="Dark">
    <Application.Styles>
        <FluentTheme />

        <!-- Palette shared with the desktop app: #151617 base, #1B1C1E surface, #232529 raised, #3D82CF accent. -->
        <Style Selector="Border.bar">
            <Setter Property="Background" Value="#1B1C1E" />
            <Setter Property="Padding" Value="8,6" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="#1B1C1E" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="#9299A4" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="TextBlock.mono">
            <Setter Property="FontFamily" Value="monospace" />
        </Style>
        <Style Selector="TextBlock.error">
            <Setter Property="Foreground" Value="#E95D5D" />
        </Style>
        <Style Selector="TextBlock.warning">
            <Setter Property="Foreground" Value="#E0A339" />
        </Style>
        <Style Selector="TextBlock.heading">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- 48dp touch targets everywhere. -->
        <Style Selector="Button">
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="MinWidth" Value="48" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#3D82CF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="#232529" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.flat">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="Button.icon">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.tab">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#9299A4" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="Button.tab.active">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#3D82CF" />
            <Setter Property="BorderThickness" Value="0,2,0,0" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <!-- List rows handle their own taps through the inner button; no selection chrome. -->
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ListBox.plain ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.plain ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Application.Styles>
</Application>
