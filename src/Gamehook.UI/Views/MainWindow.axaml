<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Gamehook.UI.ViewModels"
             xmlns:tools="using:Gamehook.UI.ViewModels.Tools"
             xmlns:dock="using:Dock.Avalonia.Controls"
             xmlns:dockmodel="using:Dock.Model.Core"
        xmlns:views="using:Gamehook.UI.Views"
        x:Class="Gamehook.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        Icon="/icon.ico"
        Width="1600" Height="900" MinWidth="640" MinHeight="360"
        CanResize="True"
        WindowDecorations="None"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="Consolas,DejaVu Sans Mono,monospace" FontSize="12">

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+T" Command="{Binding AddInstanceCommand}" />
        <KeyBinding Gesture="Ctrl+W" Command="{Binding CloseInstanceCommand}" CommandParameter="{Binding SelectedInstance}" />
    </Window.KeyBindings>

    <Window.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#151617" />
        <SolidColorBrush x:Key="TitleBrush" Color="#202123" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#1B1C1E" />
        <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#232529" />
        <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#191A1C" />
        <SolidColorBrush x:Key="FieldBrush" Color="#202630" />
        <SolidColorBrush x:Key="BorderBrush" Color="#3B3E43" />
        <SolidColorBrush x:Key="TextBrush" Color="#E3E6EB" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#9299A4" />
        <SolidColorBrush x:Key="AccentBrush" Color="#3D82CF" />
        <SolidColorBrush x:Key="AccentDarkBrush" Color="#294F7E" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#1D3047" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#47C975" />
        <SolidColorBrush x:Key="ErrorBrush" Color="#E95D5D" />
        <SolidColorBrush x:Key="WarningBrush" Color="#E0A339" />
        <SolidColorBrush x:Key="WarningSoftBrush" Color="#3A2C10" />
    </Window.Resources>

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <!-- Dock tab headers take the tab's own (state-dependent) foreground, not the global one above. -->
        <Style Selector="dock|DocumentTabStripItem TextBlock">
            <Setter Property="Foreground" Value="{Binding $parent[dock:DocumentTabStripItem].Foreground}" />
        </Style>
        <Style Selector="dock|ToolTabStripItem TextBlock">
            <Setter Property="Foreground" Value="{Binding $parent[dock:ToolTabStripItem].Foreground}" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        </Style>
        <Style Selector="TextBlock.eyebrow">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#7F9DC0" />
            <Setter Property="LetterSpacing" Value="0.7" />
        </Style>
        <!-- Selectable so users can copy error text (e.g. driver exception messages) via drag-select or right-click. -->
        <Style Selector="SelectableTextBlock.error">
            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="CornerRadius" Value="1" />
            <Setter Property="Background" Value="{StaticResource FieldBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,3" />
        </Style>
        <Style Selector="Button.action">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Background" Value="{StaticResource AccentDarkBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#4B79AD" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.action:pointerover">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style Selector="Button.secondary">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.secondary:pointerover">
            <Setter Property="Background" Value="#30343A" />
        </Style>
        <Style Selector="Button.secondary:pressed">
            <Setter Property="Background" Value="#16181B" />
        </Style>
        <Style Selector="Button.chrome">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#C5C9D0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.08" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.chrome:pointerover">
            <Setter Property="Background" Value="#33363B" />
        </Style>
        <Style Selector="Button.chrome:pressed">
            <Setter Property="Background" Value="#26282C" />
        </Style>
        <Style Selector="Button.chrome.close:pointerover">
            <Setter Property="Background" Value="#E81123" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.chrome.close:pressed">
            <Setter Property="Background" Value="#F1707A" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.chrome Path">
            <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.pin">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="4,0,2,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="TreeViewItem:pointerover Button.pin">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.pin.pinned">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Path.pin-glyph">
            <Setter Property="Fill" Value="{StaticResource MutedTextBrush}" />
        </Style>
        <Style Selector="Button.pin.pinned Path.pin-glyph">
            <Setter Property="Fill" Value="{StaticResource ErrorBrush}" />
        </Style>
        <Style Selector="Menu">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style Selector="MenuItem">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <!-- Top-level menu entries sit in the title bar: compact, rounded hover/open highlight. -->
        <Style Selector="Menu > MenuItem">
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Foreground" Value="#C5C9D0" />
        </Style>
        <Style Selector="Menu > MenuItem:pointerover /template/ Border#PART_LayoutRoot, Menu > MenuItem:selected /template/ Border#PART_LayoutRoot, Menu > MenuItem:open /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="#2E3136" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="Border.status-pill">
            <Setter Property="Background" Value="#1A1B1D" />
            <Setter Property="BorderBrush" Value="#34373C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Padding" Value="9,3,11,3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TreeViewItem" x:DataType="vm:PropertyTreeNodeViewModel">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="MinHeight" Value="18" />
        </Style>
        <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{StaticResource AccentDarkBrush}" />
        </Style>
        <Style Selector="GridSplitter:pointerover">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style Selector="ScrollBar">
            <Setter Property="AllowAutoHide" Value="False" />
        </Style>
        <Style Selector="TabItem">
            <Setter Property="Padding" Value="13,7" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="#222428" />
            <Setter Property="Foreground" Value="#AAB0B8" />
        </Style>
        <Style Selector="TabItem:selected">
            <Setter Property="Background" Value="{StaticResource AccentDarkBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <!-- ToolControl supplies each dock-panel's black/blue tab bar. Only Property becomes
             floatable after a property or byte range is selected, so only it gets this action. -->
        <Style Selector="dock|ToolControl">
            <Setter Property="HeaderTemplate">
                <DataTemplate x:DataType="dockmodel:IDockable">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding Title}" Padding="13,7" />
                        <Button Grid.Column="1" Classes="property-tab-popout" Click="PropertyTabFloatButton_Click"
                                IsVisible="{Binding CanFloat}" ToolTip.Tip="Open in new window">
                            <Path Data="M3,3 H11 V5 H5 V13 H13 V7 H15 V15 H3 Z M9,3 H15 V9 M15,3 L8,10"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.property-tab-popout">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="Margin" Value="2,0,4,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        </Style>
        <Style Selector="Button.property-tab-popout:pointerover">
            <Setter Property="Background" Value="#315A82" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Border.pinned-row">
            <Setter Property="Padding" Value="6,0" />
        </Style>
        <Style Selector="Border.pinned-row:pointerover">
            <Setter Property="Background" Value="{StaticResource SurfaceMutedBrush}" />
        </Style>
        <!-- Instance tabs: rounded-top tabs on a darker strip. The selected tab takes the surface
             colour with an accent line on top; others stay flat until hovered. -->
        <Style Selector="ListBox.instance-tabs">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
        <Style Selector="ListBox.instance-tabs ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="CornerRadius" Value="6,6,0,0" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>
        <Style Selector="ListBox.instance-tabs ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="6,6,0,0" />
        </Style>
        <Style Selector="ListBox.instance-tabs ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox.instance-tabs ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1E2023" />
        </Style>
        <Style Selector="ListBox.instance-tabs ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.instance-tabs ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox.instance-tabs ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
        </Style>
        <Style Selector="ListBox.instance-tabs TextBlock.tab-title">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        </Style>
        <Style Selector="ListBox.instance-tabs ListBoxItem:pointerover TextBlock.tab-title">
            <Setter Property="Foreground" Value="#C5C9D0" />
        </Style>
        <Style Selector="ListBox.instance-tabs ListBoxItem:selected TextBlock.tab-title">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Border.tab-indicator">
            <Setter Property="Height" Value="2" />
            <Setter Property="Margin" Value="8,0" />
            <Setter Property="CornerRadius" Value="0,0,2,2" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style Selector="Border.tab-index">
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="MinWidth" Value="16" />
            <Setter Property="Background" Value="#2C3036" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.tab-index TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        </Style>
        <Style Selector="Button.tab-close, Button.tab-add">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.tab-close">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Opacity" Value="0" />
        </Style>
        <!-- Close shows on the selected tab and whichever tab is hovered, like a browser. -->
        <Style Selector="ListBox.instance-tabs ListBoxItem:pointerover Button.tab-close, ListBox.instance-tabs ListBoxItem:selected Button.tab-close">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.tab-add">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Margin" Value="4,0,0,3" />
        </Style>
        <Style Selector="Button.tab-close:pointerover /template/ ContentPresenter, Button.tab-add:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#34383E" />
        </Style>
        <Style Selector="Button.tab-close:pointerover, Button.tab-add:pointerover">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.tab-close:disabled">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Button.tab-close Path, Button.tab-add Path">
            <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}" />
            <Setter Property="StrokeThickness" Value="1.3" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="ToolTip">
            <Setter Property="Background" Value="#25282D" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Styles>

    <Border BorderBrush="#4A4D52" BorderThickness="1" Background="{StaticResource AppBackgroundBrush}">
        <Grid RowDefinitions="38,Auto,*">
            <!-- Title bar: app icon and menu on the left, window title in the middle (drag area),
                 read status and window buttons on the right. -->
            <Border Grid.Row="0" Background="{StaticResource TitleBrush}"
                    BorderBrush="#2B2D31" BorderThickness="0,0,0,1"
                    PointerPressed="TitleBar_PointerPressed">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                    <Image Grid.Column="0" Width="16" Height="16" Margin="12,0,6,0"
                           Source="/icon.png" VerticalAlignment="Center" />
                    <Menu Grid.Column="1" VerticalAlignment="Center">
                        <MenuItem Header="File">
                            <MenuItem Header="New Instance" Command="{Binding AddInstanceCommand}" InputGesture="Ctrl+T" />
                            <MenuItem Header="Close Instance" Command="{Binding CloseInstanceCommand}" CommandParameter="{Binding SelectedInstance}" InputGesture="Ctrl+W" />
                            <Separator />
                            <MenuItem Header="Load" Command="{Binding SelectedInstance.ShowLoadScreenCommand, FallbackValue={x:Null}}" />
                            <MenuItem Header="Load Mapper…" Click="LoadMapperMenuItem_Click" />
                            <MenuItem Header="Reload" Command="{Binding SelectedInstance.ReloadCommand, FallbackValue={x:Null}}" />
                            <Separator />
                            <MenuItem Header="Exit" Click="ExitMenuItem_Click" />
                        </MenuItem>
                        <MenuItem Header="Settings">
                            <MenuItem Header="Continuous Read Mode" ToggleType="CheckBox"
                                      IsChecked="{Binding IsContinuousReadEnabled, Mode=OneWay}"
                                      Command="{Binding ToggleContinuousReadCommand}" />
                        </MenuItem>
                        <MenuItem Header="API">
                            <MenuItem x:Name="ApiDocumentationMenuItem" Header="Open API Documentation"
                                      Click="ApiDocumentationMenuItem_Click" />
                        </MenuItem>
                        <MenuItem Header="Help">
                            <MenuItem Header="About Gamehook" Click="AboutMenuItem_Click" />
                        </MenuItem>
                    </Menu>
                    <TextBlock Grid.Column="2" Text="{Binding WindowTitle}" Classes="muted"
                               FontSize="11" Margin="12,0" TextTrimming="CharacterEllipsis"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />

                    <!-- Read status for the selected tab; hover for the timing breakdown. -->
                    <Border Grid.Column="3" Classes="status-pill" Margin="0,0,10,0"
                            DataContext="{Binding SelectedInstance}" x:DataType="vm:InstanceViewModel"
                            IsVisible="{Binding IsConnected, FallbackValue=False}">
                        <ToolTip.Tip>
                            <Border Padding="10,8" MinWidth="230">
                                <StackPanel Spacing="7">
                                    <TextBlock Text="READ TIMINGS" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,6,0,0">
                                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                              ColumnSpacing="16" RowSpacing="3">
                                            <Grid.Styles>
                                                <Style Selector="TextBlock">
                                                    <Setter Property="FontFamily" Value="Cascadia Mono, Menlo, Consolas, DejaVu Sans Mono" />
                                                </Style>
                                            </Grid.Styles>
                                            <TextBlock Grid.Row="0" Text="Driver" Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding FooterDriverTime}" />
                                            <TextBlock Grid.Row="1" Text="Property translation" Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FooterPropertyTranslationTime}" />
                                            <TextBlock Grid.Row="2" Text="Inline calculations" Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding FooterInlineCalculationsTime}" />
                                            <TextBlock Grid.Row="3" Text="Processors" Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding FooterProcessorsTime}" />
                                            <TextBlock Grid.Row="4" Text="Total" FontWeight="SemiBold" Margin="0,4,0,0" />
                                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding FooterTotalTime}" FontWeight="SemiBold" Margin="0,4,0,0" />
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="{Binding FooterConnectionDetails}" TextWrapping="Wrap" MaxWidth="340"
                                               IsVisible="{Binding HasFooterConnectionDetails}" />
                                </StackPanel>
                            </Border>
                        </ToolTip.Tip>
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{Binding FooterStatusBrush}" />
                            <TextBlock Text="{Binding ReadingStatusText}" FontSize="11" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="4" Orientation="Horizontal">
                        <Button Classes="chrome" Click="MinimizeButton_Click" ToolTip.Tip="Minimize">
                            <Path Data="M0,5 H10" />
                        </Button>
                        <Button Classes="chrome" Click="MaximizeButton_Click" ToolTip.Tip="Maximize">
                            <Path x:Name="MaximizeRestoreIcon" Data="M0.5,0.5 H9.5 V9.5 H0.5 Z" />
                        </Button>
                        <Button Classes="chrome close" Click="CloseButton_Click" ToolTip.Tip="Close">
                            <Path Data="M0,0 L10,10 M10,0 L0,10" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- One tab per instance. With more than one, each shows its index - the {index} in
                 /instances/{index} API routes - as a small badge after the title. -->
            <Border Grid.Row="1" Background="{StaticResource AppBackgroundBrush}" Padding="6,6,6,0"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="Auto,Auto,*">
                    <ListBox Grid.Column="0" Classes="instance-tabs" ItemsSource="{Binding Instances}"
                             SelectedItem="{Binding SelectedInstance}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:InstanceViewModel">
                                <Grid ColumnDefinitions="*,Auto" MinWidth="120" ToolTip.Tip="{Binding Status}">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6"
                                                Margin="14,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Classes="tab-title" Text="{Binding TabTitle}" MaxWidth="220"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <Border Classes="tab-index" IsVisible="{Binding ShowIndex}">
                                            <TextBlock Text="{Binding Index}" />
                                        </Border>
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="tab-close" Margin="0,0,8,0" ToolTip.Tip="Close instance (Ctrl+W)"
                                            Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).CloseInstanceCommand}"
                                            CommandParameter="{Binding}">
                                        <Path Data="M0,0 L8,8 M8,0 L0,8" />
                                    </Button>
                                    <Border Grid.ColumnSpan="2" Classes="tab-indicator" IsVisible="{Binding IsSelected}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Grid.Column="1" Classes="tab-add" Command="{Binding AddInstanceCommand}"
                            ToolTip.Tip="New instance (Ctrl+T)">
                        <Path Data="M5,0 V10 M0,5 H10" />
                    </Button>
                </Grid>
            </Border>

            <ItemsControl Grid.Row="2" ItemsSource="{Binding Instances}">
                <!-- Every tab's view stays alive (tree expansion, scroll, dock layout); only the
                     selected one is visible. -->
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Grid />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:InstanceViewModel">
                        <views:InstanceView IsVisible="{Binding IsSelected}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Grid.RowSpan="3" Width="6" HorizontalAlignment="Left" Cursor="SizeWestEast"
                    Background="Transparent" PointerPressed="ResizeWest_PointerPressed" />
            <Border Grid.RowSpan="3" Width="6" HorizontalAlignment="Right" Cursor="SizeWestEast"
                    Background="Transparent" PointerPressed="ResizeEast_PointerPressed" />
            <Border Grid.RowSpan="3" Height="6" VerticalAlignment="Top" Cursor="SizeNorthSouth"
                    Background="Transparent" PointerPressed="ResizeNorth_PointerPressed" />
            <Border Grid.RowSpan="3" Height="6" VerticalAlignment="Bottom" Cursor="SizeNorthSouth"
                    Background="Transparent" PointerPressed="ResizeSouth_PointerPressed" />
            <Border Grid.RowSpan="3" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Cursor="TopLeftCorner"
                    Background="Transparent" PointerPressed="ResizeNorthWest_PointerPressed" />
            <Border Grid.RowSpan="3" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Cursor="TopRightCorner"
                    Background="Transparent" PointerPressed="ResizeNorthEast_PointerPressed" />
            <Border Grid.RowSpan="3" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                    Cursor="BottomLeftCorner"
                    Background="Transparent" PointerPressed="ResizeSouthWest_PointerPressed" />
            <Border Grid.RowSpan="3" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Cursor="BottomRightCorner"
                    Background="Transparent" PointerPressed="ResizeSouthEast_PointerPressed" />
        </Grid>
    </Border>
</Window>
