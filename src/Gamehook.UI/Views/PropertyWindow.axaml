<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Gamehook.UI.Views.Tools"
        xmlns:tools="using:Gamehook.UI.ViewModels.Tools"
        x:Class="Gamehook.UI.Views.PropertyWindow"
        x:DataType="tools:PropertyToolViewModel"
        Title="{Binding Title}"
        Width="390" Height="680" MinWidth="320" MinHeight="420"
        CanResize="True" Background="{StaticResource SurfaceBrush}"
        FontFamily="Consolas,DejaVu Sans Mono,monospace" FontSize="12">
    <Window.Resources>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#1B1C1E" />
        <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#191A1C" />
        <SolidColorBrush x:Key="BorderBrush" Color="#3B3E43" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#9299A4" />
        <SolidColorBrush x:Key="AccentDarkBrush" Color="#294F7E" />
    </Window.Resources>
    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="#E3E6EB" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="#9299A4" />
        </Style>
        <Style Selector="TextBlock.eyebrow">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#7F9DC0" />
            <Setter Property="LetterSpacing" Value="0.7" />
        </Style>
        <Style Selector="Button.inspector-float">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#3B3E43" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="1" />
        </Style>
    </Window.Styles>
    <Grid>
        <views:PropertyToolView />
        <!-- A popped-out inspector sits outside the main window's workspace overlay, so it needs
             its own: values here are live and editing would write. -->
        <Grid Background="#CC151617" IsVisible="{Binding !Main.IsContinuousReadEnabled}">
            <StackPanel Margin="20" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Continuous read mode disabled" FontSize="14" FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock Classes="muted" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="300"
                           Text="Values won't update while continuous read mode is off. Turn it back on from Settings &gt; Continuous Read Mode in the main window." />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
