<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tools="using:Gamehook.UI.ViewModels.Tools"
             x:Class="Gamehook.UI.Views.Tools.WorkspaceToolView"
             x:DataType="tools:WorkspaceToolViewModel">
    <Border Background="{StaticResource SurfaceBrush}">
        <StackPanel Margin="32" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360">
            <TextBlock Text="Choose a property in Explorer, then open Hex Viewer only when raw memory inspection is needed."
                       Classes="muted" TextAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</UserControl>
