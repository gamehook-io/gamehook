<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Gamehook.UI.ViewModels"
             xmlns:tools="using:Gamehook.UI.ViewModels.Tools"
             x:Class="Gamehook.UI.Views.Tools.PinnedToolView"
             x:DataType="tools:PinnedToolViewModel">
    <Grid Background="{StaticResource SurfaceBrush}">
        <StackPanel Spacing="8" Margin="22" HorizontalAlignment="Center" VerticalAlignment="Center"
                    IsVisible="{Binding !Main.HasPinnedProperties}">
            <Border Width="46" Height="46" Background="{StaticResource SurfaceMutedBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Path Data="M32 32C32 14.3 46.3 0 64 0H320c17.7 0 32 14.3 32 32s-14.3 32-32 32h-8.4l14.3 111.4c30.7 8.3 57.7 25.4 78.5 47.9c6.2 6.6 8.1 16.1 5 24.6s-11.5 14.5-20.6 14.5H32c-9.1 0-17.5-6-20.6-14.5s-1.2-18 5-24.6c20.8-22.5 47.8-39.6 78.5-47.9L108.4 64H64C46.3 64 32 49.7 32 32zM160 384h64v96c0 17.7-14.3 32-32 32s-32-14.3-32-32V384z"
                      Stretch="Uniform" Width="16" Height="16" Fill="#6E9ED4"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="No pinned properties" FontSize="14" FontWeight="SemiBold" TextAlignment="Center" />
            <TextBlock Text="Hover a property in the tree and click the pin icon to watch it here."
                       Classes="muted" TextAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>

        <DockPanel IsVisible="{Binding Main.HasPinnedProperties}">
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,20" Margin="14,10,14,4">
                <TextBlock Grid.Column="0" Text="Name" Classes="muted" FontSize="11" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="Value" Classes="muted" FontSize="11" FontWeight="SemiBold"
                           Margin="14,0,5,0" />
            </Grid>

            <ScrollViewer AllowAutoHide="False">
                <ItemsControl Margin="14,0,14,10" ItemsSource="{Binding Main.Pinned}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PropertyTreeNodeViewModel">
                            <Border Classes="pinned-row" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,0,0,1" Cursor="Hand"
                                    PointerPressed="PinnedRow_PointerPressed">
                                <Grid ColumnDefinitions="*,Auto,Auto" MinHeight="26">
                                    <TextBlock Grid.Column="0" Text="{Binding Property.Name}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayValue}" VerticalAlignment="Center"
                                               Margin="14,0,5,0" HorizontalAlignment="Right" FontSize="11"
                                               Foreground="#82B8F2" TextTrimming="CharacterEllipsis" />
                                    <Button Grid.Column="2" Classes="pin pinned"
                                            Command="{Binding TogglePinCommand}"
                                            ToolTip.Tip="Unpin property">
                                        <Path Data="M32 32C32 14.3 46.3 0 64 0H320c17.7 0 32 14.3 32 32s-14.3 32-32 32h-8.4l14.3 111.4c30.7 8.3 57.7 25.4 78.5 47.9c6.2 6.6 8.1 16.1 5 24.6s-11.5 14.5-20.6 14.5H32c-9.1 0-17.5-6-20.6-14.5s-1.2-18 5-24.6c20.8-22.5 47.8-39.6 78.5-47.9L108.4 64H64C46.3 64 32 49.7 32 32zM160 384h64v96c0 17.7-14.3 32-32 32s-32-14.3-32-32V384z"
                                              Stretch="Uniform" Width="10" Height="10" Classes="pin-glyph" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
