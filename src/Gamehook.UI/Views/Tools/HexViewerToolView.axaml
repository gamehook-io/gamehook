<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tools="using:Gamehook.UI.ViewModels.Tools"
             xmlns:controls="using:Gamehook.UI.Controls"
             x:Class="Gamehook.UI.Views.Tools.HexViewerToolView"
             x:DataType="tools:HexViewerToolViewModel">
    <Border Background="{StaticResource SurfaceBrush}" Classes="hex-viewer">
        <DockPanel>
            <Border DockPanel.Dock="Top" Height="31" Background="{StaticResource SurfaceRaisedBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <TextBlock Grid.Column="1" Text="Region"
                               Margin="0,0,7,0" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="2" Width="170" HorizontalAlignment="Right"
                              Margin="0,2,3,2" MinHeight="26"
                              ItemsSource="{Binding Main.RegionIds}" SelectedItem="{Binding Main.SelectedRegionId}"
                              IsEnabled="{Binding Main.HasProperties}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
            </Border>

            <Grid Background="{StaticResource SurfaceMutedBrush}">
                <StackPanel Spacing="7" HorizontalAlignment="Center" VerticalAlignment="Center"
                            IsVisible="{Binding !Main.HasProperties}">
                    <Border Width="46" Height="46" Background="{StaticResource AccentSoftBrush}"
                            BorderBrush="{StaticResource AccentDarkBrush}" BorderThickness="1">
                        <TextBlock Text="0F" Foreground="#73A9E5"
                                   FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="No hex data available" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Text="Load workspace to inspect raw memory regions." Classes="muted" />
                </StackPanel>
                <ScrollViewer x:Name="HexScrollViewer" IsVisible="{Binding Main.HasProperties}" AllowAutoHide="False">
                    <controls:HexEditorView Bytes="{Binding Bytes}"
                                            StartingAddress="{Binding StartingAddress}"
                                            AddressBase="{Binding AddressBase}"
                                            Properties="{Binding Main.Mapper.Properties}"
                                            RegionId="{Binding Main.SelectedRegionId}"
                                            SelectedProperty="{Binding Main.SelectedNode.Property}"
                                            PinnedProperties="{Binding Main.PinnedProperties}"
                                            RefreshToken="{Binding RefreshToken}"
                                            HorizontalAlignment="Left" VerticalAlignment="Top"
                                            x:Name="HexViewer" />
                </ScrollViewer>

                <controls:LoadingOverlay Text="Reading memory…"
                                         IsVisible="{Binding ShowLoadingSpinner}" />
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
