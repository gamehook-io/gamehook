<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <EnableAvaloniaXamlCompilation>true</EnableAvaloniaXamlCompilation>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <!-- Ahead-of-time native code reduces cold-start JIT work. -->
        <PublishReadyToRun>true</PublishReadyToRun>
        <PublishReadyToRunShowWarnings>true</PublishReadyToRunShowWarnings>
        <!-- Use runtime profiles to optimize hot paths after startup. -->
        <TieredPGO>true</TieredPGO>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\Gamehook.Domain\Gamehook.Domain.csproj" />
      <ProjectReference Include="..\Gamehook.Infrastructure\Gamehook.Infrastructure.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Avalonia" Version="12.1.2" />
      <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
      <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
      <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
      <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
      <PackageReference Include="Dock.Model" Version="12.1.0.6" />
      <PackageReference Include="Dock.Model.Mvvm" Version="12.1.0.6" />
      <PackageReference Include="Dock.Avalonia" Version="12.1.0.6" />
      <PackageReference Include="Dock.Avalonia.Themes.Fluent" Version="12.1.0.6" />
      <PackageReference Include="StaticViewLocator" Version="0.7.0" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
      <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
      <None Update="appsettings*.json" CopyToOutputDirectory="PreserveNewest" />
      <None Include="..\..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
      <AvaloniaResource Include="icon.png" />
    </ItemGroup>

</Project>
